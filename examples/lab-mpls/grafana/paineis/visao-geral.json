    {
      "id": 14,
      "type": "table",
      "title": "Sessões BGP",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "bgpPeerState",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "bgpPeerRemoteAs",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "bgpPeerFsmEstablishedTime",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "papel": true,
              "bgpPeerAdminStatus": true
            },
            "renameByName": {
              "device": "Equipamento",
              "bgpPeerRemoteAddr": "Vizinho",
              "Value #A": "Estado",
              "Value #B": "AS remoto",
              "Value #C": "Estabelecida há"
            },
            "indexByName": {
              "device": 0,
              "bgpPeerRemoteAddr": 1,
              "Value #B": 2,
              "Value #A": 3,
              "Value #C": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "idle",
                        "color": "red",
                        "index": 0
                      },
                      "2": {
                        "text": "connect",
                        "color": "orange",
                        "index": 1
                      },
                      "3": {
                        "text": "active",
                        "color": "orange",
                        "index": 2
                      },
                      "4": {
                        "text": "opensent",
                        "color": "yellow",
                        "index": 3
                      },
                      "5": {
                        "text": "openconfirm",
                        "color": "yellow",
                        "index": 4
                      },
                      "6": {
                        "text": "established",
                        "color": "green",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Estabelecida há"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Equipamento"
          }
        ]
      }
    },
