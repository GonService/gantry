    {
      "id": 10,
      "type": "row",
      "title": "Tráfego",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Tráfego total por equipamento (entrada + saída)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 1,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (device) (rate(ifHCInOctets{ifName=~\"Et.*|Vl.*\"}[$__rate_interval]) + rate(ifHCOutOctets{ifName=~\"Et.*|Vl.*\"}[$__rate_interval])) * 8",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Enlaces do núcleo (P/PE)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 1,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "rate(ifHCInOctets{papel=~\"P|PE\",ifName=~\"Et.*|Vl.*\",ifAlias!~\"GERENCIA.*\"}[$__rate_interval]) * 8",
          "legendFormat": "{{device}} {{ifName}} {{ifAlias}}"
        }
      ]
    },
    {
      "id": 13,
