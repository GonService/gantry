    {
      "id": 7,
      "type": "bargauge",
      "title": "CPU (5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max by (device) (cpmCPUTotal5minRev{job=\"rede\"}) or max by (device) (avgBusy5{job=\"rede\"})",
          "legendFormat": "{{device}}",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Memória usada (processador)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "100 * sum by (device) (ciscoMemoryPoolUsed{ciscoMemoryPoolName=\"Processor\"}) / sum by (device) (ciscoMemoryPoolUsed{ciscoMemoryPoolName=\"Processor\"} + ciscoMemoryPoolFree{ciscoMemoryPoolName=\"Processor\"})",
          "legendFormat": "{{device}}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Rotas na tabela global",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
