#!/bin/bash
# Gantry · provisionamento da Container VM {{.Name}}
# Gerado a partir das escolhas na criação. Roda uma vez, como root, dentro da
# máquina (pelo cloud-init). O mesmo arquivo fica salvo no Mac, ao lado da
# máquina, e o log de cada execução em /var/log/gantry-provision.log.
set -euo pipefail
exec >>/var/log/gantry-provision.log 2>&1
passo() { echo; echo "==> $*"; echo "gantry: $*" >/dev/hvc0 2>/dev/null || true; }
trap 'rc=$?; echo "$rc" >/var/lib/gantry-provision.rc; echo "gantry: fim rc=$rc" >/dev/hvc0 2>/dev/null || true' EXIT
export DEBIAN_FRONTEND=noninteractive

passo "1. Disco de dados: todo o estado fica nele, fora do sistema"
if ! blkid /dev/vdb >/dev/null 2>&1; then mkfs.ext4 -q -L gantry-dados /dev/vdb; fi
mkdir -p /var/lib/gantry
grep -q 'gantry-dados' /etc/fstab || echo 'LABEL=gantry-dados /var/lib/gantry ext4 defaults,discard,nofail 0 2' >>/etc/fstab
mountpoint -q /var/lib/gantry || mount /var/lib/gantry
for d in docker containers; do
  mkdir -p "/var/lib/gantry/$d" "/var/lib/$d"
  grep -q " /var/lib/$d " /etc/fstab || echo "/var/lib/gantry/$d /var/lib/$d none bind,nofail 0 0" >>/etc/fstab
  mountpoint -q "/var/lib/$d" || mount "/var/lib/$d"
done
# O disco de dados pode crescer depois (Recursos): a cada boot o ext4
# ocupa o tamanho novo, sem mexer nos dados.
cat >/etc/systemd/system/gantry-dados-cresce.service <<'EOF'
[Unit]
Description=Gantry: ocupar o tamanho atual do disco de dados
After=var-lib-gantry.mount
[Service]
Type=oneshot
ExecStart=/sbin/resize2fs /dev/vdb
[Install]
WantedBy=multi-user.target
EOF

passo "2. Pastas do Mac no mesmo caminho (virtiofs)"
mkdir -p {{.Home}}
grep -q '^home ' /etc/fstab || echo 'home {{.Home}} virtiofs rw,nofail 0 0' >>/etc/fstab
mountpoint -q {{.Home}} || mount {{.Home}}
{{- range $i, $sh := .Shares}}
mkdir -p {{$sh.Path}}
grep -q '^share{{$i}} ' /etc/fstab || echo 'share{{$i}} {{$sh.Path}} virtiofs {{if $sh.ReadOnly}}ro{{else}}rw{{end}},nofail 0 0' >>/etc/fstab
mountpoint -q {{$sh.Path}} || mount {{$sh.Path}} || true
{{- end}}

passo "3. Pacotes de base e acesso do Gantry por vsock"
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl gnupg socat chrony
# Relógio certo depois que o Mac acorda: o chrony corrige o salto na hora.
echo 'makestep 1 -1' >/etc/chrony/conf.d/gantry.conf
systemctl restart chrony || true
mkdir -p /etc/gantry
vsock() {
  cat >"/etc/systemd/system/gantry-vsock-$1.service" <<EOF
[Unit]
Description=Gantry: vsock $2 para $3
After=network.target $4
[Service]
ExecStart=/usr/bin/socat VSOCK-LISTEN:$2,reuseaddr,fork $3
Restart=always
RestartSec=1
[Install]
WantedBy=multi-user.target
EOF
}
vsock ssh {{.PortSSH}} TCP:127.0.0.1:22 ssh.service
# O Mac lê o /proc/meminfo por aqui para devolver a memória livre (balão).
vsock mem {{.PortMem}} OPEN:/proc/meminfo,rdonly
systemctl daemon-reload
systemctl enable --now gantry-vsock-ssh.service gantry-vsock-mem.service gantry-dados-cresce.service

# Sistema enxuto: nada rodando em segundo plano que não sirva aos containers.
systemctl disable --now apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer 2>/dev/null || true
mkdir -p /etc/systemd/journald.conf.d
printf '[Journal]\nSystemMaxUse=64M\nRuntimeMaxUse=32M\n' >/etc/systemd/journald.conf.d/gantry.conf
systemctl restart systemd-journald || true
# O espaço que os containers liberam volta ao Mac (os discos são esparsos).
mkdir -p /etc/systemd/system/fstrim.timer.d
printf '[Timer]\nOnCalendar=\nOnCalendar=hourly\nPersistent=true\n' >/etc/systemd/system/fstrim.timer.d/gantry.conf
systemctl daemon-reload
systemctl enable --now fstrim.timer || true
{{- if .Rosetta}}

passo "4. Rosetta para binários amd64"
mkdir -p /opt/rosetta
grep -q '^rosetta ' /etc/fstab || echo 'rosetta /opt/rosetta virtiofs ro,nofail 0 0' >>/etc/fstab
mountpoint -q /opt/rosetta || mount /opt/rosetta || true
if [ -x /opt/rosetta/rosetta ]; then
  cat >/etc/binfmt.d/rosetta.conf <<'EOF'
:rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/opt/rosetta/rosetta:CF
EOF
  systemctl restart systemd-binfmt
else
  echo "Rosetta não está instalado no Mac (softwareupdate --install-rosetta); amd64 fica de fora."
fi
{{- end}}
{{- if .QEMU}}

passo "5. QEMU para as outras arquiteturas (binfmt)"
apt-get install -y --no-install-recommends qemu-user-static || apt-get install -y --no-install-recommends qemu-user qemu-user-binfmt
{{- end}}
{{- if .Docker}}

passo "6. Docker Engine: repositório oficial, chave conferida pelo fingerprint"
. /etc/os-release
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
gpg --show-keys --with-colons /etc/apt/keyrings/docker.asc | grep -q 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $VERSION_CODENAME stable" \
  >/etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
mkdir -p /etc/docker
echo '{ "features": { "containerd-snapshotter": true } }' >/etc/docker/daemon.json
usermod -aG docker gantry
vsock docker {{.PortDocker}} UNIX-CONNECT:/run/docker.sock docker.service
systemctl daemon-reload
systemctl enable --now docker.service gantry-vsock-docker.service
systemctl restart docker.service
{{- end}}
{{- if .Podman}}

passo "7. Podman: pacote do Debian"
apt-get install -y podman
vsock podman {{.PortPodman}} UNIX-CONNECT:/run/podman/podman.sock podman.socket
systemctl daemon-reload
systemctl enable --now podman.socket gantry-vsock-podman.service
{{- end}}
{{- if .Containerd}}

passo "7b. containerd + nerdctl {{.Nerdctl}} com BuildKit (release oficial, sha256 conferido)"
arch=$(dpkg --print-architecture)
case "$arch" in
  arm64) sum={{.NerdctlArm64}} ;;
  amd64) sum={{.NerdctlAmd64}} ;;
  *) echo "arquitetura sem nerdctl: $arch"; exit 1 ;;
esac
f=/tmp/nerdctl-full.tar.gz
curl -fsSL -o "$f" "https://github.com/containerd/nerdctl/releases/download/v{{.Nerdctl}}/nerdctl-full-{{.Nerdctl}}-linux-$arch.tar.gz"
echo "$sum  $f" | sha256sum -c -
tar -C /usr/local -xzf "$f"
rm -f "$f"
systemctl daemon-reload
{{- if .Docker}}
# O containerd do Docker já roda: o nerdctl usa o mesmo (namespace default),
# sem trocar o serviço dele pelo do pacote.
rm -f /usr/local/lib/systemd/system/containerd.service
systemctl daemon-reload
systemctl enable --now buildkit.service
{{- else}}
systemctl enable --now containerd.service buildkit.service
{{- end}}
{{- end}}
{{- if .SSHAgent}}

passo "8. ssh-agent do Mac para builds e containers"
# O Gantry mantém um ssh -R do agente do Mac em
# /run/host-services/ssh-auth.sock; as chaves não saem do Mac.
echo 'd /run/host-services 0755 gantry gantry -' >/etc/tmpfiles.d/gantry-host-services.conf
systemd-tmpfiles --create /etc/tmpfiles.d/gantry-host-services.conf
echo 'StreamLocalBindUnlink yes' >/etc/ssh/sshd_config.d/gantry.conf
systemctl reload ssh.service || true
{{- end}}
{{- if .Extra}}

passo "9. Passos seus"
{{.Extra}}
{{- end}}

passo "Pronto"
# O cloud-init só serve na primeira vez; não roda mais nos boots.
touch /etc/cloud/cloud-init.disabled
